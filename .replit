modules = ["web", "bash", "nodejs-22"]

[deployment]
router = "application"
deploymentTarget = "static"
build = ["bash", "-c", "cd artifacts/greenlink-app && pnpm run build"]
publicDir = "artifacts/greenlink-app/dist/public"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GreenLink App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Mockup Sandbox"

[[workflows.workflow]]
name = "GreenLink App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/greenlink-app run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Mockup Sandbox"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8000 BASE_PATH=/__mockup/ pnpm --filter @workspace/mockup-sandbox run dev"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"
isCanvasWorkflow = true

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_gemini_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 19001
externalPort = 3002

[[ports]]
localPort = 23410
externalPort = 80

[[ports]]
localPort = 25365
externalPort = 3000

[userenv]

[userenv.shared]
CF_ACCOUNT_ID = "92ab55789050f5c4a2f3077ecb7ac148"
CF_D1_DATABASE_ID = "e3598c00-9fda-4e77-8c5b-8515a94d3de7"
CF_KV_NAMESPACE_ID = "3b54b79e2afa4320ba1eb8567e48e54b"

[userenv.production]
VITE_API_BASE_URL = "https://greenlink-pos-api.bruce42oyugi.workers.dev"

[nix]
channel = "stable-25_05"
