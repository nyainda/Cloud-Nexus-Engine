#!/usr/bin/env sh

echo "🔍 GreenLink pre-commit: checking TypeScript libs..."
pnpm run typecheck:libs
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors in shared libs. Fix before committing."
  exit 1
fi

echo "🔍 GreenLink pre-commit: checking schema consistency..."
pnpm run check-schema
if [ $? -ne 0 ]; then
  echo "❌ Schema mismatch — Drizzle schema and bootstrap SQL are out of sync."
  echo "   Fix: update both lib/db/src/schema/index.ts AND artifacts/api-server/src/lib/bootstrap-sql.ts"
  echo "   Then add an ALTER TABLE migration to artifacts/api-server/src/worker.ts MIGRATIONS array."
  exit 1
fi

echo "✅ Pre-commit checks passed."
